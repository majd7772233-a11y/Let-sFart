{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "letsfart-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://ais-dev-zce24kq2crbvmocr3iivuz-527047456045.europe-west1.run.app,https://ais-pre-zce24kq2crbvmocr3iivuz-527047456045.europe-west1.run.app"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RaftRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RaftRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "letsfart-db",
      "database_id": "c8755c17-7349-4368-85d2-82386415b5c1",
      "migrations_dir": "migrations"
    }
  ]
}
